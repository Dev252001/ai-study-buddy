# ════════════════════════════════════════════════════════════════
# AI Study Buddy — Environment Configuration
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────
APP_NAME=AI Study Buddy
APP_VERSION=1.0.0
DEBUG=false
SECRET_KEY=change-this-to-a-very-long-random-secret-key-in-production

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://studybuddy:studybuddy@postgres:5432/studybuddy
SYNC_DATABASE_URL=postgresql+psycopg2://studybuddy:studybuddy@postgres:5432/studybuddy

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── ChromaDB ─────────────────────────────────────────────────
CHROMADB_HOST=chromadb
CHROMADB_PORT=8001
CHROMADB_COLLECTION_NAME=study_buddy_docs

# ─── Embeddings ───────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ─── LLM Provider ─────────────────────────────────────────────
# Options: openai | ibm_granite | llama3 | mistral
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o

# IBM Granite (watsonx.ai)
IBM_API_KEY=your-ibm-api-key
IBM_PROJECT_ID=your-ibm-project-id
IBM_MODEL_ID=ibm/granite-13b-chat-v2

# Ollama (for Llama3 / Mistral locally)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-medium

# ─── File Upload ──────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,pptx,txt,md

# ─── OCR ──────────────────────────────────────────────────────
TESSERACT_CMD=/usr/bin/tesseract

# ─── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=AI Study Buddy <noreply@studybuddy.ai>

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost", "http://localhost:5173", "http://localhost:80"]

# ─── Monitoring ───────────────────────────────────────────────
ENABLE_METRICS=true
LOG_LEVEL=INFO

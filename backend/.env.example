# =============================================================================
# Study Buddy – Environment Variables
# Copy this file to .env and fill in real values before running the application.
# =============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="Study Buddy API"
APP_VERSION="0.1.0"
DEBUG=true

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://study_buddy:study_buddy@localhost:5432/study_buddy
# asyncpg variant – leave empty to auto-derive from DATABASE_URL
ASYNC_DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ChromaDB ─────────────────────────────────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION_NAME=study_buddy_vectors

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ibm_granite | openai | llama3 | mistral
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# IBM WatsonX / Granite
IBM_API_KEY=your-ibm-api-key-here
IBM_PROJECT_ID=your-ibm-project-id-here
IBM_MODEL_ID=ibm/granite-13b-chat-v2

# Ollama (llama3 / local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Mistral
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-medium-latest

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
# Comma-separated list of allowed extensions (no dots)
ALLOWED_EXTENSIONS=pdf,docx,pptx,txt,md,png,jpg,jpeg

# ── OCR ──────────────────────────────────────────────────────────────────────
TESSERACT_CMD=tesseract

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here
SMTP_FROM=no-reply@studybuddy.app

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
